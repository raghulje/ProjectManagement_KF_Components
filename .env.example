# Kissflow tenant (local preview only — inside Kissflow, window.kf resolves these automatically)
VITE_KF_BASE_URL=https://your-company.kissflow.com
VITE_KF_ACCOUNT_ID=your_kissflow_account_id

# Project Management case / application
VITE_KF_PM_CASE_ID=Project_Management_A01
VITE_KF_PM_LIST_VIEW_ID=Project_Management_A01_all

# Optional popup ids for task / project create-view flows (set per your tenant)
# VITE_KF_PM_TASK_POPUP_ID=your_task_popup_id
# VITE_KF_PM_PROJECT_POPUP_ID=your_project_popup_id
